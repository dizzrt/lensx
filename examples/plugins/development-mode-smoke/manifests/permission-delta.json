{
  "manifest_version": "0.1.0",
  "plugin_id": "dev.lensx.smoke.development-mode",
  "version": "0.2.0",
  "display": {
    "name": {
      "en-US": "Development Mode Smoke B",
      "zh-CN": "开发模式 Smoke B"
    },
    "description": {
      "en-US": "Generation B requests clipboard.read without receiving a grant.",
      "zh-CN": "B 代版本请求 clipboard.read，但不会因此获得授权。"
    }
  },
  "publisher": {
    "author": "lensX smoke fixture (unverified)",
    "homepage": "https://github.com/dizzrt/lensx",
    "repository": "https://github.com/dizzrt/lensx"
  },
  "compatibility": {
    "lensx": {
      "min_version": "0.1.0",
      "max_version_exclusive": "0.2.0"
    },
    "host_api": {
      "min_version": "0.1.0",
      "max_version_exclusive": "0.2.0"
    }
  },
  "runtime": {
    "kind": "iframe",
    "entry": "index.html"
  },
  "requested_permissions": [
    {
      "permission_id": "clipboard.read",
      "reason": {
        "en-US": "Verify that a reload adds a request without silently adding a grant.",
        "zh-CN": "验证 reload 只会新增权限请求，不会静默新增授权。"
      }
    }
  ],
  "contributes": {
    "pages": [
      {
        "id": "main",
        "title": {
          "en-US": "Development Mode Smoke B",
          "zh-CN": "开发模式 Smoke B"
        },
        "route": "/",
        "required_permissions": []
      }
    ],
    "actions": [
      {
        "id": "open",
        "title": {
          "en-US": "Open development-mode smoke B",
          "zh-CN": "打开开发模式 Smoke B"
        },
        "description": {
          "en-US": "Open generation B with an ungranted clipboard.read request.",
          "zh-CN": "打开已请求但未授权 clipboard.read 的 B 代版本。"
        },
        "default_keywords": {
          "en-US": ["development", "permission", "plugin", "smoke"],
          "zh-CN": ["开发", "权限", "插件", "smoke"]
        },
        "target": {
          "kind": "page",
          "page_id": "main"
        }
      }
    ],
    "launcher": {
      "default_action_id": "open"
    }
  }
}
