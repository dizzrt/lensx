{
  "name": "@lensx/example-plugin-development-mode-smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "rsbuild build && node scripts/check-csp-safe-bundle.mjs",
    "build:initial": "LENSX_PLUGIN_DEVELOPMENT_SMOKE_PHASE=initial rsbuild build && node scripts/check-csp-safe-bundle.mjs",
    "build:reload": "LENSX_PLUGIN_DEVELOPMENT_SMOKE_PHASE=reload rsbuild build && node scripts/check-csp-safe-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "rstest run",
    "check": "pnpm run typecheck && pnpm run test && node scripts/check.mjs"
  },
  "dependencies": {
    "@lensx/plugin-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@lensx/plugin-contract": "^0.2.0",
    "@rsbuild/core": "^2.1.8",
    "@rstest/adapter-rsbuild": "^0.11.2",
    "@rstest/core": "^0.11.2",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
