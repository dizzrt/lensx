{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lensx",
  "version": "0.1.0",
  "identifier": "com.dizzrt.lensx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:40755",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "lensx",
        "width": 650,
        "height": 320,
        "minWidth": 320,
        "minHeight": 180,
        "maxWidth": 4096,
        "maxHeight": 4096,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src lensx-plugin:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
