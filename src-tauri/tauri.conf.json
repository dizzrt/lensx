{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lensx",
  "version": "0.1.0",
  "identifier": "com.dizzrt.lensx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:40755",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "lensx",
        "width": 650,
        "height": 320,
        "minWidth": 650,
        "minHeight": 180,
        "maxWidth": 650,
        "maxHeight": 800,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
