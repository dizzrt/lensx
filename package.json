{
  "name": "lensx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "rsbuild",
    "dev:plugin-development-mode": "node scripts/dev-plugin-development-mode.mjs",
    "build": "node scripts/workspace-lifecycle.ts build",
    "app:build": "node scripts/app-lifecycle.ts build",
    "preview": "rsbuild preview",
    "typecheck": "node scripts/workspace-lifecycle.ts typecheck",
    "app:typecheck": "node scripts/app-lifecycle.ts typecheck",
    "test": "node scripts/workspace-lifecycle.ts test",
    "app:test": "node scripts/app-lifecycle.ts test",
    "test:watch": "rstest --watch",
    "check": "node scripts/workspace-lifecycle.ts check",
    "app:check": "node scripts/app-lifecycle.ts check",
    "gate": "node --experimental-strip-types scripts/validation/cli.ts gate",
    "generate": "node --experimental-strip-types scripts/validation/cli.ts generate",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "tauri": "tauri",
    "src-tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml --workspace",
    "src-tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "src-tauri:build": "cargo build --manifest-path src-tauri/Cargo.toml --workspace",
    "src-tauri:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "src-tauri:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "dependencies": {
    "@douyinfe/semi-ui": "^2.101.1",
    "@lensx/plugin-contract": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@rsbuild/core": "^2.1.8",
    "@rsbuild/plugin-less": "^2.0.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/adapter-rsbuild": "^0.11.2",
    "@rstest/core": "^0.11.2",
    "@structured-world/structured-zstd": "0.0.49",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@unocss/postcss": "^66.7.5",
    "ajv": "^8.20.0",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.5"
  }
}
