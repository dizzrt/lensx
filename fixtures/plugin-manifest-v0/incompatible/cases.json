[
  {
    "name": "lensX is below the supported range",
    "mutations": [
      {
        "op": "set",
        "path": "/compatibility/lensx/min_version",
        "value": "0.2.0"
      },
      {
        "op": "set",
        "path": "/compatibility/lensx/max_version_exclusive",
        "value": "0.3.0"
      }
    ],
    "expected_status": "incompatible"
  },
  {
    "name": "Host API equals the exclusive upper bound",
    "mutations": [
      {
        "op": "set",
        "path": "/compatibility/host_api/min_version",
        "value": "0.9.0"
      },
      {
        "op": "set",
        "path": "/compatibility/host_api/max_version_exclusive",
        "value": "1.0.0-dev"
      }
    ],
    "expected_status": "incompatible"
  },
  {
    "name": "release current version is above a prerelease upper range",
    "current_versions": {
      "lensx": "0.1.0",
      "host_api": "1.0.0"
    },
    "mutations": [
      {
        "op": "set",
        "path": "/compatibility/host_api/min_version",
        "value": "1.0.0-dev"
      },
      {
        "op": "set",
        "path": "/compatibility/host_api/max_version_exclusive",
        "value": "1.0.0-rc.1"
      }
    ],
    "expected_status": "incompatible"
  }
]
