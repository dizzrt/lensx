{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lensX application messages",
  "description": "Schema shared by every statically bundled lensX application locale.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "description"]
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputLabel": {
          "type": "string",
          "minLength": 1
        },
        "inputPlaceholder": {
          "type": "string",
          "minLength": 1
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resultsLabel": {
              "type": "string",
              "minLength": 1
            },
            "resultCount": {
              "type": "string",
              "minLength": 1
            },
            "noResults": {
              "type": "string",
              "minLength": 1
            },
            "executing": {
              "type": "string",
              "minLength": 1
            },
            "pendingShort": {
              "type": "string",
              "minLength": 1
            },
            "success": {
              "type": "string",
              "minLength": 1
            },
            "failure": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actionNotFound": {
                  "type": "string",
                  "minLength": 1
                },
                "actionUnavailable": {
                  "type": "string",
                  "minLength": 1
                },
                "actionExecutionFailed": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["actionNotFound", "actionUnavailable", "actionExecutionFailed"]
            }
          },
          "required": ["resultsLabel", "resultCount", "noResults", "executing", "pendingShort", "success", "failure"]
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hideLauncher": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["title", "description"]
            }
          },
          "required": ["hideLauncher"]
        }
      },
      "required": ["inputLabel", "inputPlaceholder", "search", "actions"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reload": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["title", "description", "reload"]
    }
  },
  "required": ["app", "launcher", "error"]
}
