{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lensX application messages",
  "description": "Schema shared by every statically bundled lensX application locale.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "description"]
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputLabel": {
          "type": "string",
          "minLength": 1
        },
        "inputPlaceholder": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recentTitle": {
              "type": "string",
              "minLength": 1
            },
            "pinnedTitle": {
              "type": "string",
              "minLength": 1
            },
            "allPlaceholder": {
              "type": "string",
              "minLength": 1
            },
            "recentEmpty": {
              "type": "string",
              "minLength": 1
            },
            "pinnedEmpty": {
              "type": "string",
              "minLength": 1
            },
            "pinAction": {
              "type": "string",
              "minLength": 1
            },
            "unpinAction": {
              "type": "string",
              "minLength": 1
            },
            "pinnedAction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "recentTitle",
            "pinnedTitle",
            "allPlaceholder",
            "recentEmpty",
            "pinnedEmpty",
            "pinAction",
            "unpinAction",
            "pinnedAction"
          ]
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "closeLabel": {
              "type": "string",
              "minLength": 1
            },
            "hostOwner": {
              "type": "string",
              "minLength": 1
            },
            "errorTitle": {
              "type": "string",
              "minLength": 1
            },
            "errorDescription": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["closeLabel", "hostOwner", "errorTitle", "errorDescription"]
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startupFailure": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["startupFailure"]
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resultsLabel": {
              "type": "string",
              "minLength": 1
            },
            "resultCount": {
              "type": "string",
              "minLength": 1
            },
            "noResults": {
              "type": "string",
              "minLength": 1
            },
            "executing": {
              "type": "string",
              "minLength": 1
            },
            "pendingShort": {
              "type": "string",
              "minLength": 1
            },
            "success": {
              "type": "string",
              "minLength": 1
            },
            "failure": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actionNotFound": {
                  "type": "string",
                  "minLength": 1
                },
                "actionUnavailable": {
                  "type": "string",
                  "minLength": 1
                },
                "actionExecutionFailed": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["actionNotFound", "actionUnavailable", "actionExecutionFailed"]
            }
          },
          "required": ["resultsLabel", "resultCount", "noResults", "executing", "pendingShort", "success", "failure"]
        },
        "collections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loadFailure": {
              "type": "string",
              "minLength": 1
            },
            "syncFailure": {
              "type": "string",
              "minLength": 1
            },
            "pinFailure": {
              "type": "string",
              "minLength": 1
            },
            "capacity": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["loadFailure", "syncFailure", "pinFailure", "capacity"]
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hideLauncher": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["title", "description"]
            },
            "openSettings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "keywords": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "settings": {
                      "type": "string",
                      "minLength": 1
                    },
                    "preferences": {
                      "type": "string",
                      "minLength": 1
                    },
                    "configuration": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["settings", "preferences", "configuration"]
                }
              },
              "required": ["title", "description", "keywords"]
            }
          },
          "required": ["hideLauncher", "openSettings"]
        }
      },
      "required": ["inputLabel", "inputPlaceholder", "home", "page", "preferences", "search", "collections", "actions"]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferences": {
              "type": "string",
              "minLength": 1
            },
            "plugins": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["preferences", "plugins"]
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "type": "string",
              "minLength": 1
            },
            "dark": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["label", "description", "light", "dark"]
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "enUS": {
              "type": "string",
              "minLength": 1
            },
            "zhCN": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["label", "description", "enUS", "zhCN"]
        },
        "plugins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emptyTitle": {
              "type": "string",
              "minLength": 1
            },
            "emptyDescription": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["emptyTitle", "emptyDescription"]
        },
        "save": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inProgress": {
              "type": "string",
              "minLength": 1
            },
            "failure": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["inProgress", "failure"]
        }
      },
      "required": ["title", "sections", "theme", "locale", "plugins", "save"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reload": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["title", "description", "reload"]
    }
  },
  "required": ["app", "launcher", "settings", "error"]
}
