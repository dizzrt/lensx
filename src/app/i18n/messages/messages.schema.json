{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lensX application messages",
  "description": "Schema shared by every statically bundled lensX application locale.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "description"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reload": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["title", "description", "reload"]
    }
  },
  "required": ["app", "error"]
}
