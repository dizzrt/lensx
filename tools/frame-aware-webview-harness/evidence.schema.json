{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lensx:frame-aware-webview-evidence:0.1.0",
  "title": "lensX frame-aware WebView evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_version", "run", "observations"],
  "properties": {
    "evidence_version": {
      "const": "0.1.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "engine",
        "engine_version",
        "tauri_revision",
        "wry_revision",
        "bundle_shape",
        "lease_lifecycle_verified"
      ],
      "properties": {
        "os": {
          "const": "macos"
        },
        "engine": {
          "const": "wkwebview"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^(?:unavailable|[0-9]{1,6}(?:\\.[0-9]{1,6}){0,3})$"
        },
        "tauri_revision": {
          "const": "2.11.5"
        },
        "wry_revision": {
          "const": "0.55.1"
        },
        "bundle_shape": {
          "enum": ["native_custom_protocol", "translated_custom_protocol"]
        },
        "lease_lifecycle_verified": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "event",
          "outcome",
          "fixture_frame_class",
          "native_frame_class",
          "decision",
          "precommit_outcome",
          "host_bootstrap_available",
          "descendant_bootstrap_absent",
          "handler_hit_count",
          "navigation_callback_hits",
          "popup_callback_hits",
          "download_callback_hits"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "event": {
            "enum": ["document_start", "operation_started", "operation_settled", "invoke_finished"]
          },
          "outcome": {
            "enum": ["observed", "unavailable", "resolved", "rejected", "retained", "not_retained"]
          },
          "fixture_frame_class": {
            "enum": ["main", "descendant"]
          },
          "native_frame_class": {
            "enum": ["main", "descendant", "unknown"]
          },
          "decision": {
            "enum": ["allow_main_app", "allow_active_plugin_document", "deny", "blocked_by_webview", "not_observed"]
          },
          "precommit_outcome": {
            "enum": ["committed", "rejected", "not_observed"]
          },
          "host_bootstrap_available": {
            "type": "boolean"
          },
          "descendant_bootstrap_absent": {
            "type": "boolean"
          },
          "handler_hit_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "navigation_callback_hits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "popup_callback_hits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "download_callback_hits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          }
        }
      }
    }
  }
}
