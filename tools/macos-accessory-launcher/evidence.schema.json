{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lensx.local/schemas/macos-accessory-launcher-evidence-0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "platform",
    "macos_version",
    "source_digest",
    "revisions",
    "bundle_metadata",
    "product",
    "sacrifice",
    "plugin_child",
    "gate"
  ],
  "properties": {
    "evidence_version": { "const": "0.1.0" },
    "platform": { "const": "macos" },
    "macos_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tauri", "tao", "wry"],
      "properties": {
        "tauri": { "type": "string", "minLength": 1, "maxLength": 32 },
        "tao": { "type": "string", "minLength": 1, "maxLength": 32 },
        "wry": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "bundle_metadata": { "$ref": "#/$defs/bundleMetadata" },
    "product": { "$ref": "#/$defs/product" },
    "sacrifice": { "$ref": "#/$defs/sacrifice" },
    "plugin_child": { "$ref": "#/$defs/pluginChild" },
    "gate": { "$ref": "#/$defs/gate" }
  },
  "$defs": {
    "true": { "const": true },
    "bundleMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ls_ui_element", "launch_services_start", "packaged_app"],
      "properties": {
        "ls_ui_element": { "$ref": "#/$defs/true" },
        "launch_services_start": { "$ref": "#/$defs/true" },
        "packaged_app": { "$ref": "#/$defs/true" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_version",
        "platform",
        "bundle_runtime",
        "window_policy",
        "ordinary_space",
        "fullscreen_space",
        "repeated_toggle",
        "local_shortcuts",
        "cleanup"
      ],
      "properties": {
        "evidence_version": { "const": "0.1.0" },
        "platform": { "const": "macos" },
        "bundle_runtime": { "$ref": "#/$defs/allTrue" },
        "window_policy": { "$ref": "#/$defs/allTrue" },
        "ordinary_space": { "$ref": "#/$defs/allTrue" },
        "fullscreen_space": { "$ref": "#/$defs/allTrue" },
        "repeated_toggle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repetitions",
            "exact_hide_show_pairs",
            "single_native_window",
            "recovery_shortcut_still_registered"
          ],
          "properties": {
            "repetitions": { "const": 3 },
            "exact_hide_show_pairs": { "$ref": "#/$defs/true" },
            "single_native_window": { "$ref": "#/$defs/true" },
            "recovery_shortcut_still_registered": { "$ref": "#/$defs/true" }
          }
        },
        "local_shortcuts": { "$ref": "#/$defs/allTrue" },
        "cleanup": { "$ref": "#/$defs/allTrue" }
      }
    },
    "allTrue": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/true" }
    },
    "sacrifice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_version",
        "process_alive",
        "ordinary_ready",
        "fullscreen_ready",
        "fullscreen_preserved",
        "graceful_cleanup"
      ],
      "properties": {
        "evidence_version": { "const": "0.1.0" },
        "process_alive": { "$ref": "#/$defs/true" },
        "ordinary_ready": { "$ref": "#/$defs/true" },
        "fullscreen_ready": { "$ref": "#/$defs/true" },
        "fullscreen_preserved": { "$ref": "#/$defs/true" },
        "graceful_cleanup": { "$ref": "#/$defs/true" }
      }
    },
    "pluginChild": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": { "$ref": "#/$defs/true" }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_source_digest",
        "packaged_product_executed",
        "product_process_exited",
        "setup_failure_covered_by_deterministic_tests",
        "static_results_not_substituted",
        "temporary_state_isolated",
        "bounded_timeouts",
        "graceful_cleanup"
      ],
      "properties": {
        "current_source_digest": { "$ref": "#/$defs/true" },
        "packaged_product_executed": { "$ref": "#/$defs/true" },
        "product_process_exited": { "$ref": "#/$defs/true" },
        "setup_failure_covered_by_deterministic_tests": { "$ref": "#/$defs/true" },
        "static_results_not_substituted": { "$ref": "#/$defs/true" },
        "temporary_state_isolated": { "$ref": "#/$defs/true" },
        "bounded_timeouts": { "$ref": "#/$defs/true" },
        "graceful_cleanup": { "$ref": "#/$defs/true" }
      }
    }
  }
}
