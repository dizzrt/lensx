{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lensx.local/schemas/plugin-pointer-cursor-evidence-0.7.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "attribution",
    "oracle",
    "cases",
    "host_participation_controls",
    "host_seeded_controls"
  ],
  "properties": {
    "evidence_version": { "const": "0.7.0" },
    "attribution": {
      "enum": [
        "shared_wkwebview_webkit",
        "monaco_specific_content",
        "generic_child_wkwebview_wry",
        "lensx_host_child_sibling",
        "blocked_oracle_invalid",
        "blocked_heartbeat_failed",
        "blocked_establishment_failed",
        "blocked_not_reproduced",
        "blocked_ambiguous"
      ]
    },
    "oracle": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/oracle" } },
    "cases": { "type": "array", "minItems": 8, "maxItems": 40, "items": { "$ref": "#/$defs/case" } },
    "host_participation_controls": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/case" }
    },
    "host_seeded_controls": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}$" },
    "nativeCursor": {
      "enum": ["ibeam", "arrow", "pointing_hand", "resize_horizontal", "resize_vertical", "unknown"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos_version",
        "webkit_version",
        "tauri_version",
        "wry_version",
        "device_scale_factor",
        "viewport_width",
        "viewport_height"
      ],
      "properties": {
        "macos_version": { "type": "string", "pattern": "^[0-9A-Za-z.+_-]{1,64}$" },
        "webkit_version": { "type": "string", "pattern": "^[0-9A-Za-z.+_-]{1,64}$" },
        "tauri_version": { "const": "2.11.5" },
        "wry_version": { "const": "0.55.1" },
        "device_scale_factor": { "type": "number", "minimum": 1, "maximum": 8 },
        "viewport_width": { "type": "number", "minimum": 320, "maximum": 4096 },
        "viewport_height": { "type": "number", "minimum": 240, "maximum": 2160 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_ms", "native_cursor"],
      "properties": {
        "offset_ms": { "enum": [5, 20, 35] },
        "native_cursor": { "$ref": "#/$defs/nativeCursor" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "semantic_region",
        "computed_cursor",
        "event_delivered",
        "main_run_loop_heartbeat",
        "native_cursor_snapshots",
        "document_identity",
        "editor_identity",
        "child_identity",
        "session_identity",
        "presentation_attempt",
        "bounds_revision",
        "elapsed_ms"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 18 },
        "semantic_region": {
          "enum": ["editor_text", "gutter", "scrollbar", "footer_control", "link", "overlay", "native_resize_edge"]
        },
        "computed_cursor": { "type": "string", "pattern": "^[a-z-]{1,32}$" },
        "event_delivered": { "type": "boolean" },
        "main_run_loop_heartbeat": { "type": "boolean" },
        "native_cursor_snapshots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/snapshot" }
        },
        "document_identity": { "$ref": "#/$defs/identity" },
        "editor_identity": { "$ref": "#/$defs/identity" },
        "child_identity": { "$ref": "#/$defs/identity" },
        "session_identity": { "$ref": "#/$defs/identity" },
        "presentation_attempt": { "$ref": "#/$defs/identity" },
        "bounds_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "elapsed_ms": { "type": "number", "minimum": 0, "maximum": 60000 }
      }
    },
    "establishmentSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "semantic_region",
        "computed_cursor",
        "native_cursor",
        "event_delivered",
        "main_run_loop_heartbeat",
        "document_identity",
        "editor_identity",
        "child_identity",
        "session_identity",
        "presentation_attempt",
        "bounds_revision",
        "elapsed_ms"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 12 },
        "semantic_region": { "const": "editor_text" },
        "computed_cursor": { "const": "text" },
        "native_cursor": { "$ref": "#/$defs/nativeCursor" },
        "event_delivered": { "type": "boolean" },
        "main_run_loop_heartbeat": { "type": "boolean" },
        "document_identity": { "$ref": "#/$defs/identity" },
        "editor_identity": { "$ref": "#/$defs/identity" },
        "child_identity": { "$ref": "#/$defs/identity" },
        "session_identity": { "$ref": "#/$defs/identity" },
        "presentation_attempt": { "$ref": "#/$defs/identity" },
        "bounds_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "elapsed_ms": { "type": "number", "minimum": 0, "maximum": 60000 }
      }
    },
    "establishment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_event_count",
        "required_consecutive_ibeam",
        "established",
        "first_ibeam_elapsed_ms",
        "established_elapsed_ms",
        "samples"
      ],
      "properties": {
        "maximum_event_count": { "const": 12 },
        "required_consecutive_ibeam": { "const": 3 },
        "established": { "type": "boolean" },
        "first_ibeam_elapsed_ms": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 60000 }, { "type": "null" }]
        },
        "established_elapsed_ms": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 60000 }, { "type": "null" }]
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/establishmentSample" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "repetition",
        "environment",
        "execution_mode",
        "operator_approved",
        "public_core_graphics_event_source",
        "post_event_access",
        "local_event_monitor",
        "monitor_removed",
        "content_view_flipped",
        "container_kind",
        "host_participation_mode",
        "host_isolation_mechanism",
        "host_move_delivery_count",
        "child_move_delivery_count",
        "host_establishment_move_delivery_count",
        "child_establishment_move_delivery_count",
        "host_steady_state_move_delivery_count",
        "child_steady_state_move_delivery_count",
        "host_restored",
        "host_restored_before_steady_state",
        "pre_steady_state_main_run_loop_heartbeat",
        "establishment",
        "temporary_profile",
        "graceful_shutdown",
        "pointer_restored",
        "samples"
      ],
      "properties": {
        "case_id": {
          "enum": [
            "top-level-plain-text",
            "top-level-monaco",
            "generic-child-text",
            "production-config-lens",
            "production-config-lens-host-isolated",
            "production-config-lens-host-seeded"
          ]
        },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 10 },
        "environment": { "$ref": "#/$defs/environment" },
        "execution_mode": { "enum": ["dedicated_session", "operator_approved_quiescent_desktop"] },
        "operator_approved": { "const": true },
        "public_core_graphics_event_source": { "const": true },
        "post_event_access": { "const": true },
        "local_event_monitor": { "const": true },
        "monitor_removed": { "const": true },
        "content_view_flipped": { "type": "boolean" },
        "container_kind": {
          "enum": ["top_level_wkwebview", "pure_native_window_single_child", "production_host_child"]
        },
        "host_participation_mode": { "enum": ["not_applicable", "normal", "isolated", "seeded"] },
        "host_isolation_mechanism": { "enum": ["none", "public_webview_visibility"] },
        "host_move_delivery_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "child_move_delivery_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "host_establishment_move_delivery_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "child_establishment_move_delivery_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "host_steady_state_move_delivery_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "child_steady_state_move_delivery_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "host_restored": { "const": true },
        "host_restored_before_steady_state": { "type": "boolean" },
        "pre_steady_state_main_run_loop_heartbeat": { "type": "boolean" },
        "establishment": { "$ref": "#/$defs/establishment" },
        "temporary_profile": { "const": true },
        "graceful_shutdown": { "const": true },
        "pointer_restored": { "const": true },
        "samples": { "type": "array", "minItems": 0, "maxItems": 18, "items": { "$ref": "#/$defs/sample" } }
      }
    },
    "oracleSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "semantic_region", "expected_cursor", "native_cursor", "event_delivered", "elapsed_ms"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "semantic_region": { "enum": ["text", "arrow", "link", "column_resize", "row_resize"] },
        "expected_cursor": { "enum": ["ibeam", "arrow", "pointing_hand", "resize_horizontal", "resize_vertical"] },
        "native_cursor": { "$ref": "#/$defs/nativeCursor" },
        "event_delivered": { "type": "boolean" },
        "elapsed_ms": { "type": "number", "minimum": 0, "maximum": 60000 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "repetition",
        "macos_version",
        "execution_mode",
        "operator_approved",
        "public_core_graphics_event_source",
        "post_event_access",
        "local_event_monitor",
        "temporary_profile",
        "graceful_shutdown",
        "pointer_restored",
        "monitor_removed",
        "cursor_rects_removed",
        "samples"
      ],
      "properties": {
        "case_id": { "const": "appkit-oracle" },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 10 },
        "macos_version": { "type": "string", "pattern": "^[0-9A-Za-z.+_-]{1,64}$" },
        "execution_mode": { "enum": ["dedicated_session", "operator_approved_quiescent_desktop"] },
        "operator_approved": { "const": true },
        "public_core_graphics_event_source": { "type": "boolean" },
        "post_event_access": { "type": "boolean" },
        "local_event_monitor": { "type": "boolean" },
        "temporary_profile": { "const": true },
        "graceful_shutdown": { "type": "boolean" },
        "pointer_restored": { "type": "boolean" },
        "monitor_removed": { "type": "boolean" },
        "cursor_rects_removed": { "type": "boolean" },
        "samples": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/oracleSample" } }
      }
    }
  }
}
