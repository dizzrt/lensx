{
  "name": "@lensx/plugin-testkit",
  "version": "0.2.0",
  "description": "Framework-neutral fixtures and semantic transport controls for lensX plugin tests.",
  "keywords": [
    "lensx",
    "plugin",
    "testing",
    "testkit"
  ],
  "homepage": "https://github.com/dizzrt/lensx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizzrt/lensx.git",
    "directory": "packages/plugin-testkit"
  },
  "bugs": {
    "url": "https://github.com/dizzrt/lensx/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "rstest run",
    "check": "biome check .",
    "test:pack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@lensx/plugin-contract": "workspace:*",
    "@lensx/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@rstest/core": "^0.11.2",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
