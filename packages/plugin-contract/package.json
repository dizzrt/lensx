{
  "name": "@lensx/plugin-contract",
  "version": "0.1.0",
  "description": "Public, deterministic lensX plugin Manifest contract.",
  "keywords": [
    "lensx",
    "plugin",
    "manifest",
    "json-schema"
  ],
  "homepage": "https://github.com/dizzrt/lensx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizzrt/lensx.git",
    "directory": "packages/plugin-contract"
  },
  "bugs": {
    "url": "https://github.com/dizzrt/lensx/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "import": "./dist/src/schema.js"
    },
    "./manifest.schema.json": "./dist/schema/manifest.schema.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "rstest run",
    "check": "pnpm run check:generated && pnpm run typecheck",
    "generate": "node scripts/generate-plugin-manifest-types.mjs",
    "check:generated": "node scripts/generate-plugin-manifest-types.mjs --check",
    "test:pack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@rstest/core": "^0.11.2",
    "@types/node": "^24.13.3",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
