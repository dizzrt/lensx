[
  {
    "name": "legacy 0.3 webview protocol is incompatible without alias",
    "mutations": [
      {
        "op": "set",
        "path": "/manifest_version",
        "value": "0.3.0"
      }
    ],
    "expected_status": "incompatible",
    "expected_diagnostics": [
      {
        "code": "incompatible_protocol",
        "path": "/manifest_version"
      }
    ]
  },
  {
    "name": "legacy 0.2 iframe protocol is incompatible without rewrite",
    "mutations": [
      {
        "op": "set",
        "path": "/manifest_version",
        "value": "0.2.0"
      },
      {
        "op": "set",
        "path": "/runtime/kind",
        "value": "iframe"
      }
    ],
    "expected_status": "incompatible",
    "expected_diagnostics": [
      {
        "code": "incompatible_protocol",
        "path": "/manifest_version"
      },
      {
        "code": "incompatible_protocol",
        "path": "/runtime/kind"
      }
    ]
  },
  {
    "name": "iframe Runtime kind is incompatible without fallback",
    "mutations": [
      {
        "op": "set",
        "path": "/runtime/kind",
        "value": "iframe"
      }
    ],
    "expected_status": "incompatible",
    "expected_diagnostics": [
      {
        "code": "incompatible_protocol",
        "path": "/runtime/kind"
      }
    ]
  },
  {
    "name": "lensX is below the supported range",
    "mutations": [
      {
        "op": "set",
        "path": "/compatibility/lensx/min_version",
        "value": "0.2.0"
      },
      {
        "op": "set",
        "path": "/compatibility/lensx/max_version_exclusive",
        "value": "0.3.0"
      }
    ],
    "expected_status": "incompatible"
  },
  {
    "name": "Host API equals the exclusive upper bound",
    "mutations": [
      {
        "op": "set",
        "path": "/compatibility/host_api/min_version",
        "value": "0.0.1"
      },
      {
        "op": "set",
        "path": "/compatibility/host_api/max_version_exclusive",
        "value": "0.2.0"
      }
    ],
    "expected_status": "incompatible"
  },
  {
    "name": "release current version is above a prerelease upper range",
    "current_versions": {
      "lensx": "0.1.0",
      "host_api": "1.0.0"
    },
    "mutations": [
      {
        "op": "set",
        "path": "/compatibility/host_api/min_version",
        "value": "0.2.0"
      },
      {
        "op": "set",
        "path": "/compatibility/host_api/max_version_exclusive",
        "value": "1.0.0-rc.1"
      }
    ],
    "expected_status": "incompatible"
  }
]
