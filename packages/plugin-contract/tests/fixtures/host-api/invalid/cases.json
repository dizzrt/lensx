[
  {
    "name": "unknown-method",
    "kind": "request",
    "value": { "method": "system.open_external", "params": {} },
    "expected": [{ "code": "method_not_found", "path": "/method" }]
  },
  {
    "name": "context-unknown-capability",
    "kind": "context",
    "value": {
      "hostApiVersion": "0.2.0",
      "locale": "en-US",
      "theme": "light",
      "capabilities": ["system.open_external"]
    },
    "expected": [{ "code": "invalid_value", "path": "/capabilities/0" }]
  },
  {
    "name": "context-duplicate-capability",
    "kind": "context",
    "value": {
      "hostApiVersion": "0.2.0",
      "locale": "en-US",
      "theme": "light",
      "capabilities": ["storage.get", "storage.get"]
    },
    "expected": [{ "code": "duplicate_value", "path": "/capabilities" }]
  },
  {
    "name": "context-unsorted-capability",
    "kind": "context",
    "value": {
      "hostApiVersion": "0.2.0",
      "locale": "en-US",
      "theme": "light",
      "capabilities": ["storage.get", "actions.open"]
    },
    "expected": [{ "code": "unsorted_value", "path": "/capabilities/1" }]
  },
  {
    "name": "context-trusted-field",
    "kind": "context",
    "value": {
      "hostApiVersion": "0.2.0",
      "locale": "en-US",
      "theme": "light",
      "capabilities": [],
      "pluginId": "com.attacker.plugin"
    },
    "expected": [{ "code": "additional_property", "path": "/pluginId" }]
  },
  {
    "name": "event-is-patch",
    "kind": "event",
    "value": { "event": "runtime.context_changed", "payload": { "theme": "dark" } },
    "expected": [
      { "code": "required", "path": "/payload/capabilities" },
      { "code": "required", "path": "/payload/hostApiVersion" },
      { "code": "required", "path": "/payload/locale" }
    ]
  },
  {
    "name": "ui-close-target",
    "kind": "request",
    "value": { "method": "ui.close", "params": { "windowId": "main" } },
    "expected": [{ "code": "additional_property", "path": "/params/windowId" }]
  },
  {
    "name": "actions-global-id",
    "kind": "request",
