{
  "name": "@lensx/plugin-ui",
  "version": "0.1.0",
  "description": "Optional React and Semi Design UI foundation for lensX plugins.",
  "keywords": [
    "lensx",
    "plugin",
    "react",
    "ui"
  ],
  "homepage": "https://github.com/dizzrt/lensx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizzrt/lensx.git",
    "directory": "packages/plugin-ui"
  },
  "bugs": {
    "url": "https://github.com/dizzrt/lensx/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "rstest run",
    "check": "pnpm run typecheck && pnpm run test",
    "test:pack": "node scripts/verify-package.mjs",
    "test:visual": "node scripts/verify-visual.mjs"
  },
  "dependencies": {
    "@douyinfe/semi-ui": "^2.101.1"
  },
  "peerDependencies": {
    "@lensx/plugin-sdk": "^0.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@lensx/plugin-sdk": "workspace:*",
    "@rsbuild/core": "^2.1.8",
    "@rsbuild/plugin-less": "^2.0.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/core": "^0.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.0",
    "less": "^4.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
